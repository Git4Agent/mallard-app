{
  "name": "mallard",
  "private": true,
  "version": "0.1.6",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:release-version": "node scripts/check-release-version.mjs",
    "preview": "vite preview",
    "typecheck:frontend-tests": "tsc --project tsconfig.frontend-tests.json",
    "test:frontend-integration": "npm run typecheck:frontend-tests && node scripts/run-frontend-integration-tests.mjs",
    "test:release-config": "node --test tests/release-config.test.mjs tests/updater-manifest.test.mjs",
    "test:aimock-servers": "node --test scripts/live-codex-aimock-server.test.mjs scripts/live-claude-aimock-server.test.mjs",
    "test:backend-integration": "cargo test --workspace --all-targets && npm run test:aimock-servers && npm run test:mixed-aimock-harness",
    "test:storage-catalog-e2e": "cargo test --manifest-path src-tauri/Cargo.toml --test storage_catalog_e2e",
    "test:cli": "cargo test -p mallard-cli",
    "test:live-claude-aimock-e2e": "node scripts/run-live-claude-aimock-e2e.mjs",
    "test:live-claude-tuzi-e2e": "node scripts/run-live-claude-tuzi-e2e.mjs",
    "test:live-codex-aimock-e2e": "node scripts/run-live-codex-aimock-e2e.mjs",
    "test:live-codex-e2e": "node scripts/run-live-codex-e2e.mjs",
    "test:integration": "npm run test:frontend-integration && npm run test:release-config && npm run test:backend-integration",
    "tauri": "node scripts/tauri-build.mjs",
    "test:mixed-aimock-harness": "node --test scripts/mixed-aimock.test.mjs",
    "test:mixed-aimock-e2e": "node scripts/run-mixed-aimock-e2e.mjs",
    "bench:mixed-aimock-e2e": "node scripts/run-mixed-aimock-e2e.mjs --benchmark",
    "test:mixed-aimock-e2e-xlarge": "node scripts/run-mixed-aimock-e2e.mjs --profile=xlarge",
    "bench:mixed-aimock-e2e-xlarge": "node scripts/run-mixed-aimock-e2e.mjs --profile=xlarge --benchmark"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "katex": "^0.16.47",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.39.0",
    "@mermaid-js/tiny": "11.15.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^20.19.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "esbuild": "^0.28.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
