#!/usr/bin/expect -f

# Fork a saved Codex CLI session, wait until the fork is persisted, and close
# the interactive TUI without submitting a prompt.

proc fail {message {status 1}} {
  puts stderr "codex-fork-and-exit: $message"
  exit $status
}

proc usage {} {
  puts stderr "Usage: codex-fork-and-exit SESSION_ID \[PROJECT_DIR\]"
  puts stderr ""
  puts stderr "Environment:"
  puts stderr "  CODEX_HOME          Codex configuration/session home (default: ~/.codex)"
  puts stderr "  CODEX_BIN           Codex executable (default: codex)"
  puts stderr "  CODEX_FORK_TIMEOUT  Seconds to wait for the fork (default: 45)"
}

proc rollout_files {codex_home} {
  return [glob -nocomplain -types f \
    [file join $codex_home sessions * * * "rollout-*.jsonl"]]
}

proc fork_id_from_new_rollout {codex_home source_id before_name} {
  upvar 1 $before_name before

  foreach path [rollout_files $codex_home] {
    if {[info exists before($path)]} {
      continue
    }

    if {[catch {
      set handle [open $path r]
      set metadata [gets $handle]
      close $handle
    }]} {
      continue
    }

    set fork_pattern [format \
      {"forked_from_id"[[:space:]]*:[[:space:]]*"%s"} \
      $source_id]
    if {![regexp $fork_pattern $metadata]} {
      continue
    }

    if {[regexp \
      {([[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12})\.jsonl$} \
      $path -> fork_id]} {
      return $fork_id
    }
  }

  return ""
}

if {$argc < 1 || $argc > 2} {
  usage
  exit 2
}

set source_id [string tolower [lindex $argv 0]]
if {![regexp \
  {^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$} \
  $source_id]} {
  fail "SESSION_ID must be a UUID" 2
}

if {$argc == 2} {
  set project_dir [file normalize [lindex $argv 1]]
} else {
  set project_dir [pwd]
}
if {![file isdirectory $project_dir]} {
  fail "project directory does not exist: $project_dir" 2
}

if {[info exists env(CODEX_HOME)] && $env(CODEX_HOME) ne ""} {
  set codex_home [file normalize $env(CODEX_HOME)]
} else {
  set codex_home [file normalize "~/.codex"]
}

if {[info exists env(CODEX_BIN)] && $env(CODEX_BIN) ne ""} {
  set codex_bin $env(CODEX_BIN)
} else {
  set codex_bin "codex"
}
set codex_command [auto_execok $codex_bin]
if {$codex_command eq ""} {
  fail "Codex executable not found: $codex_bin"
}

if {[info exists env(CODEX_FORK_TIMEOUT)] && $env(CODEX_FORK_TIMEOUT) ne ""} {
  set fork_timeout $env(CODEX_FORK_TIMEOUT)
} else {
  set fork_timeout 45
}
if {![string is integer -strict $fork_timeout] || $fork_timeout < 1} {
  fail "CODEX_FORK_TIMEOUT must be a positive integer" 2
}

array set before {}
foreach path [rollout_files $codex_home] {
  set before($path) 1
}

if {[catch {exec {*}$codex_command login status 2>@1}]} {
  fail "Codex authentication is not configured in $codex_home"
}

if {![info exists env(TERM)] || $env(TERM) eq "" || $env(TERM) eq "dumb"} {
  set env(TERM) "xterm-256color"
}

# Keep the TUI out of the caller's terminal. Its output may contain the source
# conversation, so do not echo or retain it.
log_user 0
match_max 65536
set timeout 1

spawn -noecho {*}$codex_command fork --no-alt-screen \
  -C $project_dir $source_id
set codex_pid [exp_pid]
stty rows 40 columns 120

set deadline [expr {[clock milliseconds] + ($fork_timeout * 1000)}]
set fork_id ""
set failure ""
set child_eof 0

while {[clock milliseconds] < $deadline} {
  set fork_id [fork_id_from_new_rollout $codex_home $source_id before]
  if {$fork_id ne ""} {
    break
  }

  expect {
    -re {Welcome to Codex} {
      set failure "Codex authentication is not configured in $codex_home"
    }
    -re {(?i)(session|conversation|thread).*(not found|does not exist|failed to load)} {
      set failure "Codex could not load source session $source_id"
    }
    eof {
      set child_eof 1
    }
    timeout {
    }
  }

  if {$failure ne "" || $child_eof} {
    break
  }
}

if {$fork_id eq ""} {
  if {!$child_eof} {
    send -- "\003"
    set timeout 5
    expect eof
  }
  catch {wait}

  if {$failure ne ""} {
    fail $failure
  }
  if {$child_eof} {
    fail "Codex exited before persisting a fork of $source_id"
  }
  fail "timed out after $fork_timeout seconds waiting for Codex to persist the fork"
}

# The rollout exists, so the fork is durable. Give the composer a moment to
# become ready, enter the documented /exit command slowly, then press Enter.
after 500
set send_slow {1 0.04}
send -s -- "/exit"
after 100
send -- "\r"

set timeout 10
expect {
  eof {
    set child_eof 1
  }
  timeout {
    # Ctrl+C is Codex's other documented way to close an idle session.
    send -- "\003"
    set timeout 5
    expect {
      eof {
        set child_eof 1
      }
      timeout {
      }
    }
  }
}

if {!$child_eof} {
  catch {exec kill -TERM $codex_pid}
  set timeout 5
  expect eof
}
catch {wait}

puts "forked_thread_id=$fork_id"
