{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mallard-vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 1420,
      "autoPort": false
    },
    {
      "name": "mallard-vite-attach",
      "url": "http://localhost:1420",
      "port": 1420
    },
    {
      "name": "managed-cloud-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd ../mallardInternal/cloudflare/managed-cloud && export PATH=\"$HOME/.nvm/versions/node/v22.22.0/bin:$PATH\" && npm run db:migrate:local && npm run build:web && npx wrangler dev --port 8787"
      ],
      "port": 8787,
      "autoPort": false
    },
    {
      "name": "managed-cloud-web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-lc",
        "cd ../mallardInternal/cloudflare/managed-cloud && export PATH=\"$HOME/.nvm/versions/node/v22.22.0/bin:$PATH\" && npx vite --config web/vite.config.ts"
      ],
      "port": 5173,
      "autoPort": false
    }
  ]
}
